<!-- Add inside <ossec_config> in /var/ossec/etc/ossec.conf on the Wazuh manager.
     Wazuh's built-in "shuffle" integration just POSTs the alert JSON to hook_url, so it can point
     straight at SOC Core now, and at a Shuffle workflow later (Shuffle then calls SOC Core / TheHive). -->
<integration>
  <name>shuffle</name>
  <hook_url>http://SOC_CORE_HOST:5000/api/ingest/wazuh?tenant=city-hospital</hook_url>
  <level>7</level>
  <alert_format>json</alert_format>
</integration>
